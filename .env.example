# Optional: xAI / SpaceXAI (OpenAI-compatible). Used for LLM reply drafting
# and LLM-as-judge. The project runs fully offline without this key.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# Optional: Kaggle credentials for the full Customer Support on Twitter dataset.
# Place kaggle.json in ~/.kaggle/ or set these variables.
# https://www.kaggle.com/docs/api
KAGGLE_USERNAME=
KAGGLE_KEY=

# Reproducibility
RANDOM_SEED=42
