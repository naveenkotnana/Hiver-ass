# Trained artifacts (regenerated by scripts/run_demo.py)
artifacts/models/
artifacts/index/
artifacts/predictions/
artifacts/*.joblib
artifacts/*.pkl
.pytest_cache/

# Assignment prompt dump if present
*.docx

# Keep directory placeholders
!artifacts/.gitkeep
!data/processed/.gitkeep
!data/sample/.gitkeep

# Notebooks / logs
*.ipynb_checkpoints/
logs/
*.log

# Optional LLM cache
.llm_cache/
